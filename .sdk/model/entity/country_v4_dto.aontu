            version: 2
          }
          m: "GET"
          o: "/api/v4/Countries/Available"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v4"
            }
            {
              lit: "Countries"
            }
            {
              lit: "Available"
            }
          ]
          t: {
